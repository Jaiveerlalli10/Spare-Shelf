rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /posts/{postId} {
      // Anyone signed in can read the board.
      allow read: if signedIn();
      // You can only create posts as yourself.
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (
        // The owner can change anything on their own post.
        resource.data.ownerId == request.auth.uid ||
        // Anyone can claim an open post.
        (resource.data.status == "open" &&
         request.resource.data.claimedById == request.auth.uid &&
         onlyChanges(["status", "claimedById", "claimedByName", "claimedByEmail", "claimerApproxLat", "claimerApproxLng"])) ||
        // The claimer can save their (rounded) location, so a requester can walk to them.
        (resource.data.claimedById == request.auth.uid &&
         onlyChanges(["claimerApproxLat", "claimerApproxLng"])) ||
        // The claimer can confirm their side of the hand-off. It only becomes
        // "completed" if the owner has already confirmed.
        (resource.data.claimedById == request.auth.uid &&
         onlyChanges(["claimerConfirmed", "status"]) &&
         request.resource.data.claimerConfirmed == true &&
         (request.resource.data.status == "claimed" ||
          (request.resource.data.status == "completed" && resource.data.get("ownerConfirmed", false) == true)))
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    // Profile is private. Housing coordinates have to sit near the campus point.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.universityName is string
        && request.resource.data.housingLabel is string
        && request.resource.data.universityLat is number
        && request.resource.data.universityLng is number
        && request.resource.data.housingLat is number
        && request.resource.data.housingLng is number
        && request.resource.data.housingLat >= request.resource.data.universityLat - 0.25
        && request.resource.data.housingLat <= request.resource.data.universityLat + 0.25
        && request.resource.data.housingLng >= request.resource.data.universityLng - 0.6
        && request.resource.data.housingLng <= request.resource.data.universityLng + 0.6
        && request.resource.data.photoURL.size() < 200000
        && request.resource.data.bio.size() < 500;
      allow delete: if false;
    }

    // Name + profile picture, readable by anyone signed in (used for chat photos).
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["name", "photoURL", "updatedAt"])
        && request.resource.data.name is string
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() < 200000;
    }

    // Each person's pantry is private: only they can read or change it.
    match /users/{userId}/pantry/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Chats (one per pair of people): only the two people in a chat can see it or send messages in it.
    // The chat doc also holds their pickup spots (pickups.{postId}), so those stay private too.
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members &&
                    request.resource.data.members == resource.data.members;

      match /messages/{messageId} {
        function isMember() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        // getAfter: the first message can be sent in the same batch that creates the chat.
        function isMemberAfter() {
          return request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMemberAfter() && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
