rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /posts/{postId} {
      // Anyone signed in can read the board.
      allow read: if signedIn();
      // You can only create posts as yourself.
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (
        // The owner can change anything on their own post.
        resource.data.ownerId == request.auth.uid ||
        // Anyone can claim an open post.
        (resource.data.status == "open" &&
         request.resource.data.claimedById == request.auth.uid &&
         onlyChanges(["status", "claimedById", "claimedByName", "claimedByEmail"])) ||
        // The claimer can confirm their side of the hand-off. It only becomes
        // "completed" if the owner has already confirmed.
        (resource.data.claimedById == request.auth.uid &&
         onlyChanges(["claimerConfirmed", "status"]) &&
         request.resource.data.claimerConfirmed == true &&
         (request.resource.data.status == "claimed" ||
          (request.resource.data.status == "completed" && resource.data.get("ownerConfirmed", false) == true)))
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Each person's pantry is private: only they can read or change it.
    match /users/{userId}/pantry/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Chats: only the two people in a chat can see it or send messages in it.
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members &&
                    request.resource.data.members == resource.data.members;

      match /messages/{messageId} {
        function isMember() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember() && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
