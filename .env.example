# Copy this file to .env.local and fill in the values from
# Firebase console -> Project settings -> Your apps -> Web app config.
# If these are left empty, the app runs in DEMO MODE with fake data saved in your browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: reCAPTCHA Enterprise site key from Firebase console > App Check
VITE_RECAPTCHA_SITE_KEY=...
