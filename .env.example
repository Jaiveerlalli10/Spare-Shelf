# Copy this file to .env.local and fill in the values from
# Firebase console -> Project settings -> Your apps -> Web app config.
# If these are left empty, the app runs in DEMO MODE with fake data saved in your browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: reCAPTCHA Enterprise site key from Firebase console > App Check
VITE_RECAPTCHA_SITE_KEY=...

# ---------- Payments (payments branch, Stripe TEST mode) ----------
# Shows the payment features in the app. Leave unset to hide them.
VITE_PAYMENTS=
# Server-only secrets: NO "VITE_" prefix, so they never reach the browser.
# Stripe dashboard (test mode) -> Developers -> API keys -> Secret key (sk_test_...)
STRIPE_SECRET_KEY=
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Paste the JSON file's contents on one line (or base64 of it).
FIREBASE_SERVICE_ACCOUNT=
